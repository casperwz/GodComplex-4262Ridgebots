<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.image.Image?>

<?import javafx.scene.image.Image?>
<Pane prefHeight="400.0" prefWidth="600.0"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cs112.lab09.controllers.MapController">
   <children>
      <ImageView fx:id="mapImageView" fitHeight="400.0" fitWidth="600.0"
                 layoutX="0.0" layoutY="0.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/Red-Summer.jpg" />
         </image>
      </ImageView>

      <Button fx:id="bisbeeAzButton" layoutX="92.0" layoutY="210.0" mnemonicParsing="false"
              onAction="#onBisbeeAzButtonClick" text="Bisbee, AZ" />
      <Button fx:id="tulsaOkButton" layoutX="211.0" layoutY="277.0" mnemonicParsing="false"
              onAction="#onTulsaOkButtonClick" text="Tulsa, OK" />
   </children>
</Pane>