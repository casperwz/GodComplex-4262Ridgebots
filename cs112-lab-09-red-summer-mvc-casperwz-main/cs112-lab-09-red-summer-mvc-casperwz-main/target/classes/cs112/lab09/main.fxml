<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="480.0" prefWidth="460.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cs112.lab09.controllers.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="25.0" />
    </padding>
    <children>
        <Label fx:id="titleLabel" text="Interactive Revisionist History Map">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>
        <Label fx:id="subtitleLabel" text="Red Summer Edition">
            <font><Font size="14.0" /></font>
        </Label>
        <Label fx:id="descriptionLabel" alignment="CENTER" maxWidth="1.7976931348623157E308"
               prefHeight="99.0" text="App Description/Intro" textAlignment="CENTER"
               textFill="#9f9f9f" wrapText="true">
            <font><Font size="18.0" /></font>
            <VBox.margin><Insets top="10.0" /></VBox.margin>
        </Label>
        <ImageView fx:id="logoImageView" fitHeight="150.0" fitWidth="200.0"
                   pickOnBounds="true" preserveRatio="true" />
        <HBox alignment="BOTTOM_CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <Button fx:id="startButton" mnemonicParsing="false" onAction="#onStartButtonClick"
                        prefWidth="90.0" text="Start" />
                <Button fx:id="quitButton" mnemonicParsing="false" onAction="#onQuitButtonClick"
                        prefWidth="90.0" text="Quit" />
            </children>
        </HBox>
    </children>
</VBox>