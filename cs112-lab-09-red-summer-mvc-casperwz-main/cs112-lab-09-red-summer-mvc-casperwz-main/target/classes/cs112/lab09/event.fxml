<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cs112.lab09.controllers.EventController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <left>
      <ImageView fx:id="eventImageView" fitHeight="260.0" fitWidth="200.0"
                 pickOnBounds="true" preserveRatio="true" BorderPane.alignment="CENTER" />
   </left>
   <right>
      <BorderPane prefWidth="350.0" BorderPane.alignment="CENTER">
         <padding><Insets left="15.0" /></padding>
         <top>
            <VBox spacing="4.0" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="locationLabel" text="Location">
                     <font><Font name="System Bold" size="18.0" /></font>
                  </Label>
                  <Label fx:id="dateLabel" text="Date" />
               </children>
            </VBox>
         </top>
         <center>
            <VBox spacing="12.0" BorderPane.alignment="CENTER">
               <padding><Insets bottom="12.0" top="12.0" /></padding>
               <children>
                  <Label fx:id="descriptionLabel" maxWidth="1.7976931348623157E308"
                         text="Description" wrapText="true" VBox.vgrow="ALWAYS" />
                  <Label fx:id="revisedDescriptionLabel" maxWidth="1.7976931348623157E308"
                         text="RevisedDescription" wrapText="true" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </center>
         <bottom>
            <Hyperlink fx:id="citationHyperlink" onAction="#onCitationHyperlinkClick"
                       text="Source" BorderPane.alignment="CENTER_LEFT" />
         </bottom>
      </BorderPane>
   </right>
   <bottom>
      <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onCloseButtonClick"
              text="Close" BorderPane.alignment="CENTER">
         <BorderPane.margin><Insets top="10.0" /></BorderPane.margin>
      </Button>
   </bottom>
</BorderPane>